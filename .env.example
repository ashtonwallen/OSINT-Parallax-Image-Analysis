# Build-time subpath, e.g. /projects/parallax. Empty serves at /.
BASE_PATH=
# Public origin used in Open Graph metadata; no trailing slash.
NEXT_PUBLIC_SITE_URL=
# Visitors configure their own provider keys in the UI. No owner API key is used.
# Optional switch to reject cloud requests; direct local connections remain available.
DISABLE_CLOUD_AI=false
# Optional distributed limit: 5 requests / 10 minutes / IP.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random long secret used to hash IP addresses before rate limiting.
RATE_LIMIT_SALT=
# Set true to reject cloud requests if the distributed limiter is unavailable.
REQUIRE_DISTRIBUTED_RATE_LIMIT=false
